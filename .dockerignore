# Keep the build context small and the image clean.
.git
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Local virtualenvs / envs
.venv/
venv/
env/

# Large raw data and caches never belong in the image (mounted at runtime)
data/raw/
data/cache/
uploads/
jobs/
*.zip
kaggle.json

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs / tests that don't affect the running service
notebook/
*.md
