# ---------------------------------------------------------------------------
# HAM10000 deployment — .gitignore
#
# NOTE: models/ is intentionally NOT ignored. The trained model files
# (skin_lesion_model.keras / .h5) and model_meta.json MUST be committed so the
# repo is self-contained and the API runs without a training step.
# ---------------------------------------------------------------------------

# --- Raw data & caches (large / licensed — download from Kaggle instead) ---
data/raw/
# Note the trailing /* — git cannot re-include a file whose parent DIRECTORY is
# excluded, so `data/cache/` would silently drop the .gitkeep negation below.
data/cache/*
!data/cache/.gitkeep
*.npy
*.npz

# --- Split image folders: the jpgs are ~2.6 GB and are downloaded, not vendored
# (see data/README.md). The train_/test_metadata.csv manifests ARE committed. ---
data/train/images/*
data/test/images/*
!data/train/images/.gitkeep
!data/test/images/.gitkeep

# --- Runtime state (generated by the running services) ---
uploads/*
jobs/*
# ...but keep the directories themselves so bind mounts have a source:
!uploads/.gitkeep
!jobs/.gitkeep

# --- Secrets & archives ---
kaggle.json
*.zip

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Model promotion backups / temp files (keep the live model, drop churn) ---
models/*.bak
models/*.tmp
models/*.promote_tmp.*

# --- Editor / OS noise ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Scratch ---
.nb_outline.txt
.cell_*.txt
